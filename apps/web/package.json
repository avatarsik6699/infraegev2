    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
