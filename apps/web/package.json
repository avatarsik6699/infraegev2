    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.121.0",
    "nitro": "3.0.260610-beta",
    "openapi-fetch": "0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
