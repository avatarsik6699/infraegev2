{
  "schema_version": 2,
  "target_id": "infraegev2-production",
  "project": {
    "slug": "infraegev2",
    "name": "infraegev2",
    "description": "Public learning product and its production infrastructure"
  },
  "note": "Operator-owned template, not a direct API payload. Create the Project first, assign every Source to it and keep all credentials in sre-kit. The push token is generated once by sre-kit and injected only into the target producer environment.",
  "sources": [
    {
      "name": "Public availability",
      "adapter_name": "uptime-http",
      "config": {
        "url": "https://infraege.ru/health/ready",
        "method": "GET",
        "expect_status": 200,
        "tls_expiry_warn_days": 14
      }
    },
    {
      "name": "Host resources",
      "adapter_name": "host-metrics-ssh",
      "config": {
        "host": "2.26.8.245",
        "port": 22,
        "username": "root",
        "auth_method": "password",
        "secret": "<create-in-sre-kit>",
        "host_key_fingerprint": "SHA256:<verify-independently>"
      }
    },
    {
      "name": "Security bans",
      "adapter_name": "fail2ban-ssh",
      "config": {
        "host": "2.26.8.245",
        "port": 22,
        "username": "root",
        "auth_method": "password",
        "secret": "<create-in-sre-kit>",
        "host_key_fingerprint": "SHA256:<verify-independently>",
        "lookback_seconds": 120
      }
    },
    {
      "name": "Application journal",
      "adapter_name": "journal-http",
      "config": {
        "host": "10.77.0.1",
        "port": 19531,
        "https": false,
        "min_priority": 6,
        "lookback_seconds": 120,
        "parse_json_message": true
      }
    },
    {
      "name": "Container telemetry",
      "adapter_name": "beszel-api",
      "config": {
        "base_url": "http://10.77.0.1:8090",
        "system_id": "<beszel-system-record-id>",
        "email": "ops@infraege.ru",
        "password": "<create-in-sre-kit>",
        "auth_collection": "users",
        "lookback_seconds": 120
      }
    },
    {
      "name": "Product analytics",
      "adapter_name": "umami-http",
      "config": {
        "base_url": "http://10.77.0.1:3001",
        "website_id": "6deca958-82df-4809-9973-e0e367b7ee29",
        "username": "<create-in-umami>",
        "password": "<create-in-sre-kit>",
        "lookback_seconds": 3600,
        "tracked_events": [
          "lesson_opened",
          "theory_section_viewed",
          "practice_started",
          "practice_answer_checked",
          "lesson_completed",
          "continuation_opened"
        ],
        "dimensions": [
          "url",
          "referrer",
          "country",
          "region",
          "city",
          "browser",
          "os",
          "device",
          "language"
        ]
      }
    },
    {
      "name": "Nginx traffic",
      "adapter_name": "push",
      "purpose": "Coarse Nginx traffic aggregates produced by build-traffic-telemetry.py",
      "config": {
        "token": "<generate-and-store-outside-git>",
        "idempotency_key": "<unique-per-batch>"
      },
      "emits": ["traffic.request_count"],
      "labels": ["traffic_class", "path", "status_family"]
    }
  ]
}
