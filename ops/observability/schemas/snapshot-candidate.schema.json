{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraege.ru/schemas/ops/snapshot-candidate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "observed_at",
    "reachable",
    "eligible",
    "production_mutated",
    "data_transferred",
    "authorized_to_restore",
    "authorized_to_cutover",
    "snapshot",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 },
    "reachable": { "type": "boolean" },
    "eligible": { "type": "boolean" },
    "production_mutated": { "const": false },
    "data_transferred": { "const": false },
    "authorized_to_restore": { "const": false },
    "authorized_to_cutover": { "const": false },
    "snapshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "time"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "time": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "enum": ["umami-dump", "beszel-data"] },
          "kind": { "enum": ["file", "directory"] },
          "path": {
            "type": "string",
            "pattern": "^/var/backups/infraege/work\\.[A-Za-z0-9]+/(umami\\.dump|beszel-data)$"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["ssh_unreachable", "invalid_response"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
