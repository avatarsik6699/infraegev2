{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "production_data_used",
    "authorized_to_cutover",
    "images",
    "postgres",
    "beszel",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "passed" },
    "production_data_used": { "const": false },
    "authorized_to_cutover": { "const": false },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "beszel"],
      "properties": {
        "postgres": {
          "const": "postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777"
        },
        "beszel": {
          "const": "henrygd/beszel:0.18.7@sha256:a849ad80814b6a1a3be665304dcace5d4854b3bed7bde4dd1227e8ce1b82d477"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "row_count",
        "event_total",
        "sequence_preserved",
        "ownership_preserved"
      ],
      "properties": {
        "status": { "const": "passed" },
        "row_count": { "const": 3 },
        "event_total": { "const": 10 },
        "sequence_preserved": { "const": true },
        "ownership_preserved": { "const": true }
      }
    },
    "beszel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_healthy",
        "target_healthy",
        "identity_preserved",
        "state_files_present"
      ],
      "properties": {
        "status": { "const": "passed" },
        "source_healthy": { "const": true },
        "target_healthy": { "const": true },
        "identity_preserved": { "const": true },
        "state_files_present": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers_removed",
        "volumes_removed",
        "workspace_removed"
      ],
      "properties": {
        "containers_removed": { "const": true },
        "volumes_removed": { "const": true },
        "workspace_removed": { "const": true }
      }
    }
  }
}
