{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "bundle_id",
    "source_owner",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "bundle_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_owner": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
