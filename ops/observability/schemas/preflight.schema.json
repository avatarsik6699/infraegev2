{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "bundle_id",
    "observed_at",
    "reachable",
    "ready_for_migration_planning",
    "authorized_to_apply",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "bundle_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "minLength": 1 },
    "reachable": { "type": "boolean" },
    "ready_for_migration_planning": { "type": "boolean" },
    "authorized_to_apply": { "const": false },
    "summary": { "type": "object" },
    "checks": { "type": "array", "minItems": 1 }
  }
}
