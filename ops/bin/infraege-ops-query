#!/usr/bin/env bash
set -euo pipefail

command_name=${SSH_ORIGINAL_COMMAND:-${1:-}}

# sre-kit's fail2ban-ssh and host-metrics-ssh adapters (unlike the retired apps/ops integration)
# send their own fixed, non-parameterized remote commands directly over SSH exec, rather than a
# short keyword — see sre-kit's adapters/fail2ban-ssh/main.go (tailLog) and
# adapters/host-metrics-ssh/main.go (sampleScript). Matched here by exact string, same trust model
# as the keyword case below: the SSH key alone already scopes who can ask; this only scopes what a
# holder of that key is allowed to run. If either adapter's command ever changes, this comparison
# must be updated to match — a text change here breaks silently otherwise (adapter always gets
# "unsupported operation" until this file is redeployed to match the new source).
sre_kit_fail2ban_tail='tail -n 2000 /var/log/fail2ban.log'
# ANSI-C-quoted, not a heredoc: must match adapters/host-metrics-ssh/main.go's sampleScript
# byte-for-byte (leading/trailing newline included) — a heredoc + `read -d ''` was tried first and
# silently drops exactly one leading and one trailing newline, which would make this comparison
# always fail. Regenerate with the exact bytes if sampleScript ever changes; don't hand-edit
# around the string content, hand-edit the source and re-derive this literal from it.
sre_kit_host_metrics_script=$'\nread cpu user nice system idle iowait irq softirq steal rest < /proc/stat\nidle1=$((idle + iowait))\ntotal1=$((user + nice + system + idle + iowait + irq + softirq + steal))\nsleep 1\nread cpu user nice system idle iowait irq softirq steal rest < /proc/stat\nidle2=$((idle + iowait))\ntotal2=$((user + nice + system + idle + iowait + irq + softirq + steal))\nidle_delta=$((idle2 - idle1))\ntotal_delta=$((total2 - total1))\ncpu_pct=$(awk -v idle="$idle_delta" -v total="$total_delta" \'BEGIN { if (total > 0) printf "%.2f", (1 - idle/total) * 100; else print "0" }\')\nmem_total=$(awk \'/MemTotal/{print $2}\' /proc/meminfo)\nmem_avail=$(awk \'/MemAvailable/{print $2}\' /proc/meminfo)\nmem_pct=$(awk -v total="$mem_total" -v avail="$mem_avail" \'BEGIN { if (total > 0) printf "%.2f", (1 - avail/total) * 100; else print "0" }\')\ndisk_pct=$(df -P / | awk \'NR==2{gsub(/%/,"",$5); print $5}\')\nprintf \'%s %s %s\\n\' "$cpu_pct" "$mem_pct" "$disk_pct"\n'

if [[ "$command_name" == "$sre_kit_fail2ban_tail" ]]; then
  sudo -n /usr/bin/tail -n 2000 /var/log/fail2ban.log
  exit 0
fi
if [[ "$command_name" == "$sre_kit_host_metrics_script" ]]; then
  bash -c "$sre_kit_host_metrics_script"
  exit 0
fi

case "$command_name" in
  fail2ban-status)
    sudo -n /usr/bin/fail2ban-client status
    sudo -n /usr/bin/fail2ban-client status sshd
    sudo -n /usr/bin/fail2ban-client status infraege-nginx-limit
    ;;
  backup-status)
    if [[ -r /var/lib/infraege/backup-status.json ]]; then
      cat /var/lib/infraege/backup-status.json
    else
      printf '%s\n' '{"status":"missing"}'
    fi
    ;;
  deploy-status)
    if [[ -r /var/lib/infraege/deploy-status.json ]]; then
      cat /var/lib/infraege/deploy-status.json
    else
      printf '%s\n' '{"status":"unknown"}'
    fi
    ;;
  *)
    echo "unsupported operation" >&2
    exit 64
    ;;
esac
