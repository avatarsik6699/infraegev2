                },
                {
                  "$ref": "#/components/schemas/WorkedExampleBlock"
                },
                {
                  "$ref": "#/components/schemas/CalloutBlock"
                }
              ]
            },
            "title": "Explanation",
            "type": "array"
          }
        },
        "required": [
          "correct",
          "explanation"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "ClientErrorReport": {
        "additionalProperties": false,
        "description": "Bounded diagnostic fields only; free-form exception data is deliberately forbidden.",
        "properties": {
          "asset_path": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^/(?:_build|assets)/[A-Za-z0-9._/\\-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Path"
          },
          "column": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          },
          "fingerprint": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "kind": {
            "enum": [
              "render",
              "route_load",
              "chunk_load",
              "unhandled_error",
              "unhandled_rejection"
            ],
            "title": "Kind",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "route_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^/[A-Za-z0-9_.$/\\-]+$",
            "title": "Route Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "route_id",
          "fingerprint"
        ],
        "title": "ClientErrorReport",
        "type": "object"
      },
