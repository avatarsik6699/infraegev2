{
  "components": {
    "schemas": {
      "CalloutBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CalloutBlockData"
          },
          "type": {
            "const": "callout",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "CalloutBlock",
        "type": "object"
      },
      "CalloutBlockData": {
        "additionalProperties": false,
        "properties": {
          "markdown": {
            "title": "Markdown",
            "type": "string"
          },
          "tone": {
            "enum": [
              "info",
              "warning"
            ],
            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "tone",
          "markdown"
        ],
        "title": "CalloutBlockData",
        "type": "object"
      },
      "CheckRequest": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResponse": {
        "properties": {
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "explanation": {
            "items": {
              "discriminator": {
                "mapping": {
                  "callout": "#/components/schemas/CalloutBlock",
                  "code_example": "#/components/schemas/CodeExampleBlock",
                  "completion_exercise": "#/components/schemas/WorkedExampleBlock",
                  "learning_visual": "#/components/schemas/LearningVisualBlock",
                  "productive_failure_prompt": "#/components/schemas/WorkedExampleBlock",
                  "text": "#/components/schemas/TextBlock",
                  "video_embed": "#/components/schemas/VideoEmbedBlock",
                  "worked_example": "#/components/schemas/WorkedExampleBlock"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/LearningVisualBlock"
                },
                {
                  "$ref": "#/components/schemas/CodeExampleBlock"
                },
                {
                  "$ref": "#/components/schemas/WorkedExampleBlock"
                },
                {
                  "$ref": "#/components/schemas/CalloutBlock"
                },
                {
                  "$ref": "#/components/schemas/VideoEmbedBlock"
                }
              ]
            },
            "title": "Explanation",
            "type": "array"
          }
        },
        "required": [
          "correct",
          "explanation"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "ClientErrorReport": {
        "additionalProperties": false,
        "description": "Bounded diagnostic fields only; free-form exception data is deliberately forbidden.",
        "properties": {
          "asset_path": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^/(?:_build|assets)/[A-Za-z0-9._/\\-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Path"
          },
          "column": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          },
          "fingerprint": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "kind": {
            "enum": [
              "render",
              "route_load",
              "chunk_load",
              "unhandled_error",
              "unhandled_rejection"
            ],
            "title": "Kind",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "route_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^/[A-Za-z0-9_.$/\\-]+$",
            "title": "Route Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "route_id",
          "fingerprint"
        ],
        "title": "ClientErrorReport",
        "type": "object"
      },
      "CodeExampleBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CodeExampleBlockData"
          },
          "type": {
            "const": "code_example",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "CodeExampleBlock",
        "type": "object"
      },
      "CodeExampleBlockData": {
        "additionalProperties": false,
        "properties": {
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "language",
          "code"
        ],
        "title": "CodeExampleBlockData",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HybridLearningVisualData": {
        "additionalProperties": false,
        "properties": {
          "accessible_description": {
            "title": "Accessible Description",
            "type": "string"
          },
          "asset": {
            "$ref": "#/components/schemas/LearningVisualAsset"
          },
          "caption": {
            "title": "Caption",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "representation": {
            "const": "hybrid",
            "title": "Representation",
            "type": "string"
          },
          "visual": {
            "$ref": "#/components/schemas/StructuredLearningVisual"
          }
        },
        "required": [
          "representation",
          "purpose",
          "accessible_description",
          "caption",
          "asset",
          "visual"
        ],
        "title": "HybridLearningVisualData",
        "type": "object"
      },
      "JsonValue": {},
      "LearningVisualAsset": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "src": {
            "title": "Src",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "src",
          "width",
          "height"
        ],
        "title": "LearningVisualAsset",
        "type": "object"
      },
      "LearningVisualBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "discriminator": {
              "mapping": {
                "hybrid": "#/components/schemas/HybridLearningVisualData",
                "raster": "#/components/schemas/RasterLearningVisualData",
                "structured": "#/components/schemas/StructuredLearningVisualData"
              },
              "propertyName": "representation"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RasterLearningVisualData"
              },
              {
                "$ref": "#/components/schemas/StructuredLearningVisualData"
              },
              {
                "$ref": "#/components/schemas/HybridLearningVisualData"
              }
            ],
            "title": "Data"
          },
          "type": {
            "const": "learning_visual",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "LearningVisualBlock",
        "type": "object"
      },
      "RasterLearningVisualData": {
        "additionalProperties": false,
        "properties": {
          "accessible_description": {
            "title": "Accessible Description",
            "type": "string"
          },
          "asset": {
            "$ref": "#/components/schemas/LearningVisualAsset"
          },
          "caption": {
            "title": "Caption",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "representation": {
            "const": "raster",
            "title": "Representation",
            "type": "string"
          }
        },
        "required": [
          "representation",
          "purpose",
          "accessible_description",
          "caption",
          "asset"
        ],
        "title": "RasterLearningVisualData",
        "type": "object"
      },
      "StructuredLearningVisual": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "minProperties": 1,
            "title": "Data",
            "type": "object"
          },
          "kind": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "data"
        ],
        "title": "StructuredLearningVisual",
        "type": "object"
      },
      "StructuredLearningVisualData": {
        "additionalProperties": false,
        "properties": {
          "accessible_description": {
            "title": "Accessible Description",
            "type": "string"
          },
          "caption": {
            "title": "Caption",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "representation": {
            "const": "structured",
            "title": "Representation",
            "type": "string"
          },
          "visual": {
            "$ref": "#/components/schemas/StructuredLearningVisual"
          }
        },
        "required": [
          "representation",
          "purpose",
          "accessible_description",
          "caption",
          "visual"
        ],
        "title": "StructuredLearningVisualData",
        "type": "object"
      },
      "TextBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TextBlockData"
          },
          "type": {
            "const": "text",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "TextBlock",
        "type": "object"
      },
      "TextBlockData": {
        "additionalProperties": false,
        "properties": {
          "markdown": {
            "title": "Markdown",
            "type": "string"
          }
        },
        "required": [
          "markdown"
        ],
        "title": "TextBlockData",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoEmbedBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/VideoEmbedBlockData"
          },
          "type": {
            "const": "video_embed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "VideoEmbedBlock",
        "type": "object"
      },
      "VideoEmbedBlockData": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "title": "VideoEmbedBlockData",
        "type": "object"
      },
      "WorkedExampleBlock": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkedExampleBlockData"
          },
          "type": {
            "enum": [
              "worked_example",
              "completion_exercise",
              "productive_failure_prompt"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "WorkedExampleBlock",
        "type": "object"
      },
      "WorkedExampleBlockData": {
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "prompt",
          "steps"
        ],
        "title": "WorkedExampleBlockData",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "infraege API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/client-errors": {
      "post": {
        "operationId": "reportClientError",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientErrorReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Report Client Error",
        "tags": [
          "client-errors"
        ]
      }
    },
    "/api/tasks/{task_id}/check": {
      "post": {
        "operationId": "check_answer_api_tasks__task_id__check_post",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Answer"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_alias_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Alias Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Alias"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Liveness Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readiness Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
