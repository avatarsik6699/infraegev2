          "explanation": {
            "items": {
              "discriminator": {
                "mapping": {
                  "attachment": "#/components/schemas/AttachmentBlock",
                  "callout": "#/components/schemas/CalloutBlock",
                  "code_example": "#/components/schemas/CodeExampleBlock",
                  "completion_exercise": "#/components/schemas/WorkedExampleBlock",
                  "diagram": "#/components/schemas/DiagramBlock",
                  "image": "#/components/schemas/ImageBlock",
