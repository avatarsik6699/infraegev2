    "statement": [
      {
        "data": {
          "spans": [
            {
              "kind": "text",
              "text": "(А.Богданов) Обозначим операцию целочисленного деления с округлением вниз как "
            },
            {
              "kind": "formula",
              "text": "//"
            },
            {
              "kind": "text",
              "text": ", а нахождения остатка деления через "
            },
            {
              "kind": "formula",
              "text": "\\%"
            },
            {
              "kind": "text",
              "text": ". Например, "
            },
            {
              "kind": "formula",
              "text": "8 // 3 == 2"
            },
            {
              "kind": "text",
              "text": " и "
            },
            {
              "kind": "formula",
              "text": "7 \\% 3 == 1"
            },
            {
              "kind": "text",
              "text": ". Алгоритм вычисления значения функции "
            },
            {
              "kind": "formula",
              "text": "F(n)"
            },
            {
              "kind": "text",
              "text": ", где "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": " – целое число, задан следующими соотношениями:"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n) = n // 3 + n \\% 3"
            },
            {
              "kind": "text",
              "text": ", если "
            },
            {
              "kind": "formula",
              "text": "n < 9"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n) = F(n // 9) + F(n \\% 9)"
            },
            {
              "kind": "text",
              "text": ", если "
            },
            {
              "kind": "formula",
              "text": "n ≥ 9"
            }
          ]
        },
        "type": "rich_text"
      },
      {
