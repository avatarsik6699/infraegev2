        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=1"
            },
            {
              "kind": "text",
              "text": ", при "
            },
            {
              "kind": "formula",
              "text": "n≥ 10 000"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=n\\% 10+F(n+2)"
            },
            {
              "kind": "text",
              "text": ", при "
            },
            {
              "kind": "formula",
              "text": "10<n<10 000"
            },
            {
              "kind": "text",
              "text": " и четном значении "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": ","
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=F(n-2)-(n-1)\\% 10"
            },
            {
              "kind": "text",
              "text": ", при "
            },
            {
              "kind": "formula",
              "text": "10<n<10 000"
            },
            {
              "kind": "text",
              "text": " и нечетном значении "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "text",
              "text": "Чему равно значение выражения "
            },
            {
              "kind": "formula",
              "text": "F(4500)+F(5515)"
            },
            {
              "kind": "text",
              "text": "? В ответе запишите только целое число."
