      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=n"
            },
            {
              "kind": "text",
              "text": ", при "
            },
            {
              "kind": "formula",
              "text": "n≤ 10"
            }
          ]
