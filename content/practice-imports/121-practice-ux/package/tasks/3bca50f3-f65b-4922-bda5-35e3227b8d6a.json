          "spans": [
            {
              "kind": "text",
              "text": "(М. Попков) В многопользовательской игре “Короли Пяти Морей” игроки соревнуются за контроль над морскими путями. Каждое стратегическое действие обозначается числом "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": ", а функция "
            },
            {
              "kind": "formula",
              "text": "F(n)"
            },
            {
              "kind": "text",
              "text": " помогает определить оптимальное время для атаки или обороны. Правильное определение "
            },
            {
              "kind": "formula",
              "text": "F(n)"
            },
            {
              "kind": "text",
              "text": " позволяет игроку эффективно планировать свои ходы и увеличивать шансы на победу в морских сражениях."
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "text",
              "text": "Алгоритм вычисления значения функции "
            },
            {
              "kind": "formula",
              "text": "F(n)"
            },
            {
              "kind": "text",
              "text": ", где "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": " – натуральное число, задан следующими соотношениями:"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=13"
            },
            {
              "kind": "text",
              "text": " при "
            },
            {
              "kind": "formula",
              "text": "n<13"
            },
            {
              "kind": "text",
              "text": ";"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=13-F(n-1)"
            },
            {
              "kind": "text",
              "text": ", если "
            },
            {
              "kind": "formula",
              "text": "n≥ 13"
            },
            {
              "kind": "text",
              "text": " и значение "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": " не кратно 5;"
            }
          ]
        },
        "type": "rich_text"
      },
      {
        "data": {
          "spans": [
            {
              "kind": "formula",
              "text": "F(n)=13+F(n-1)"
            },
            {
              "kind": "text",
              "text": ", если "
            },
            {
              "kind": "formula",
              "text": "n≥ 13"
            },
            {
              "kind": "text",
              "text": " и значение "
            },
            {
              "kind": "formula",
              "text": "n"
            },
            {
              "kind": "text",
              "text": " кратно 5"
            }
          ]
        },
        "type": "rich_text"
      },
