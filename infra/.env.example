# Copy to infra/.env and fill in real values — docker compose auto-loads infra/.env for ${VAR}
# interpolation in the compose files. Never commit the real infra/.env (see .gitignore).

# Application PostgreSQL.
POSTGRES_USER=infraege
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infraege

# Backend (apps/api/app/core/config.py)
APP_ENV=production
LOG_LEVEL=INFO
DEPLOY_SHA=replace-with-full-commit-sha

# Frontend analytics identifier.
VITE_UMAMI_WEBSITE_ID=replace-with-umami-website-uuid

# Private observability sources. Bind only to the server WireGuard address.
WIREGUARD_IP=10.77.0.1
UMAMI_DATABASE_URL=postgresql://umami:replace-url-encoded-password@postgres:5432/umami
UMAMI_DB_PASSWORD=replace-with-random-password
UMAMI_APP_SECRET=replace-with-openssl-rand-hex-32
BESZEL_AGENT_TOKEN=replace-from-beszel-settings
BESZEL_AGENT_KEY=replace-from-beszel-system
