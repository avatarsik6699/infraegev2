# Copy to infra/.env and fill in real values — docker compose auto-loads infra/.env for ${VAR}
# interpolation in the compose files. Never commit the real infra/.env (see .gitignore).

# Application PostgreSQL.
POSTGRES_USER=infraege
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infraege
# Generate each independently with `openssl rand -hex 24`; never reuse bootstrap credentials.
DB_RUNTIME_PASSWORD=replace-with-runtime-password
DB_IMPORT_PASSWORD=replace-with-import-password
DB_MIGRATION_PASSWORD=replace-with-migration-password
DB_BACKUP_PASSWORD=replace-with-backup-password

# Backend (apps/api/app/core/config.py)
APP_ENV=production
LOG_LEVEL=INFO
DEPLOY_SHA=replace-with-full-commit-sha

# Frontend analytics identifier.
VITE_UMAMI_WEBSITE_ID=replace-with-umami-website-uuid
