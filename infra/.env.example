# Copy to infra/.env and fill in real values — docker compose auto-loads infra/.env for ${VAR}
# interpolation in the compose files. Never commit the real infra/.env (see .gitignore).

# Application PostgreSQL.
POSTGRES_USER=infraege
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infraege
# Generate each independently with `openssl rand -hex 24`; never reuse bootstrap credentials.
DB_RUNTIME_PASSWORD=replace-with-runtime-password
DB_IMPORT_PASSWORD=replace-with-import-password
DB_MIGRATION_PASSWORD=replace-with-migration-password
DB_BACKUP_PASSWORD=replace-with-backup-password
DB_APP_PASSWORD=replace-with-application-write-password
# Generate independently with `openssl rand -hex 32`; used only to derive same-origin CSRF tokens.
AUTH_CSRF_SECRET=replace-with-csrf-secret

# Account delivery and federated-login configuration. Callback URLs are derived only from
# PUBLIC_ORIGIN; register exactly https://infraege.ru/api/auth/providers/<provider>/callback.
PUBLIC_ORIGIN=https://infraege.ru
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=accounts@infraege.ru
VK_CLIENT_ID=replace-with-vk-client-id
VK_CLIENT_SECRET=replace-with-vk-client-secret
VK_APP_ID=replace-with-vk-app-id
VK_ENABLED=false
YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
YANDEX_ENABLED=false
TELEGRAM_CLIENT_ID=replace-with-telegram-client-id
TELEGRAM_CLIENT_SECRET=replace-with-telegram-client-secret
TELEGRAM_ENABLED=false

# Backend (apps/api/app/core/config.py)
APP_ENV=production
LOG_LEVEL=INFO
DEPLOY_SHA=replace-with-full-commit-sha

# Persistent immutable task objects; production must use this absolute host path.
TASK_FILES_DIR=/var/lib/infraege/task-files
