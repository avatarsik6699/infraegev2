# Copy to infra/.env and fill in real values — docker compose auto-loads infra/.env for ${VAR}
# interpolation in the compose files. Never commit the real infra/.env (see .gitignore).

# Postgres (docker-compose.yml) — provisioned ahead of a possible future analytics aggregation
# table (docs/SPEC.md §3); the backend does not read DATABASE_URL yet.
POSTGRES_USER=infraege
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infraege

# Telegram alerting (docs/SPEC.md §7.2) — alerts are skipped with a warning log if unset.
# Required in production (docker-compose.prod.yml hard-fails without them).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backend (apps/api/app/core/config.py)
APP_ENV=production
LOG_LEVEL=INFO

# Frontend build-time sitemap generation (apps/web/src/routes/sitemap[.]xml.ts) — required in
# production (docker-compose.prod.yml hard-fails without it).
SITE_URL=https://example.invalid

# Frontend feedback link (apps/web/src/shared/config/env.ts)
VITE_FEEDBACK_URL=https://t.me/REPLACE_WITH_FEEDBACK_CHANNEL
