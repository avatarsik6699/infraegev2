  "narrative": {
    "northStar": "The Clean Textbook",
    "overview": "infraege looks like a well-made textbook: a white page, calm sans-serif type, generous line height\nand colour used like bookmarks, not decoration. The home page is the cover: it is the one\ngenuinely colourful screen, with soft pastel plates that invite a learner in. Every other page is\nan inside page: white, quiet, built for reading and solving, with at most one colour plate that\nmarks the main next step.\n\nIdentity comes from a few precise details rather than ornament: the three-stone logo, a barely\nvisible engineering grid in page heads, ink-black primary buttons, blue links you can recognise at\na glance, and one orange line that always means \"you are here\". Density is moderate: big readable\nblocks, quiet hairline separators, small corner radii. Light theme only.\n\nConfirmed rejections: dark or terminal/neon looks; a colour per site section; yellow or blush\nplates; orange-filled buttons; AI-template badges (\"бесплатно, без регистрации\" pills); the stone\ncairn as a progress indicator; handwritten signatures as a brand device; a warm tinted surface\nspread across every page; colourful cartoon illustrations.",
    "keyCharacteristics": [
      "White reading surfaces; colour concentrated on the home page.",
      "Ink primary actions, blue links, orange only for position.",
      "Engineering grid in page heads, fading to every edge.",
      "Hand-drawn monochrome line illustrations on pastel or neutral plates.",
      "One progress indicator per piece of progress; no duplicates."
    ],
    "rules": [
      {
        "name": "The Cover Rule",
        "body": "Pastel colour belongs to the home page. Any other page gets at most one pastel\nplate, and only for its main next step.",
        "section": "colors"
      },
      {
        "name": "The One Meaning Rule",
        "body": "Each accent has exactly one job: blue is a link, orange is \"you are\nhere\", green/red are answer results. A colour never borrows another's job, so unrelated elements\nare never visually linked.",
        "section": "colors"
      },
      {
        "name": "The No Section Colour Rule",
        "body": "Sections are told apart by headings and illustrations, never by a\ncolour. Adding a section adds no colour.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Onest for all prose and UI; JetBrains Mono only for code, IDs and\nnumbers in tables; Caveat only inside diagrams.",
        "section": "typography"
      },
      {
        "name": "The Flat Page Rule",
        "body": "Cards, tiles and plates never cast shadows at rest; hover changes the\nborder or fill, not elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep reading areas (lesson, task, forms) on white.",
      "**Do** make links Hyperlink Blue everywhere and keep orange for \"you are here\" only.",
      "**Do** use at most one pastel plate on any page other than home.",
      "**Do** keep text on plates in Textbook Ink or Secondary Ink.",
      "**Do** show each piece of progress once per page.",
      "**Do** use the engineering grid only in page heads, faded to the edges."
    ],
    "donts": [
      "**Don't** assign colours to site sections.",
      "**Don't** fill buttons with orange or pastel; primary buttons are ink.",
      "**Don't** use orange for links, code, warnings, focus rings, badges or diagram emphasis.",
      "**Don't** use yellow or blush plates, or red outside errors and destructive actions.",
      "**Don't** add AI-template badges, cairn progress indicators or handwritten signatures.",
      "**Don't** spread a tinted surface across whole pages.",
      "**Don't** add a left panel to pages where it would duplicate content (course overview,"
    ]
  }
}