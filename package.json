{
  "name": "infraege",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier . --write && cd apps/api && uv run ruff format app tests",
    "format:check": "prettier . --check && cd apps/api && uv run ruff format --check app tests",
    "api:generate": "node scripts/api-contracts.mjs",
    "api:check": "node scripts/api-contracts.mjs --check",
    "validate:content": "node scripts/validate-content-links.mjs",
    "audit:a11y": "pnpm --filter web exec playwright test e2e/accessibility.spec.ts",
    "audit:performance": "lhci autorun",
    "audit:security": "bash scripts/security-gate.sh",
    "audit:images": "bash scripts/image-gate.sh"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "prettier": "3.9.6",
    "pyright": "1.1.411"
  },
  "version": "1.0.0",
  "description": "Техническая платформа будущего веб-приложения для подготовки к ЕГЭ по информатике. Публичный frontend временно сведён к нейтральному стенду переиспользуемого Table of Contents; учебные страницы и конкретный контент будут спроектированы заново.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avatarsik6699/infraegev2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/avatarsik6699/infraegev2/issues"
  },
  "homepage": "https://github.com/avatarsik6699/infraegev2#readme"
}
